{
  "name": "browser-and-web-need-a-person",
  "promise": "A browser action from an MCP tool asks a person, and a stopped session makes no web calls that could carry data out.",
  "steps": [
    {
      "tool": ["mcp__claude-in-chrome__navigate", { "url": "https://example.com" }],
      "expect": "ask",
      "reason": "acts in a browser",
      "why": "pages are content anyone can fill"
    },
    {
      "tool": ["mcp__Claude_Browser__javascript_tool", { "text": "document.cookie" }],
      "expect": "ask"
    },
    {
      "tool": ["mcp__Claude_Browser__read_page", {}],
      "expect": "allow",
      "why": "reading a page is not an action"
    },
    {
      "tool": ["WebFetch", { "url": "https://example.com/?q=notes" }],
      "expect": "allow"
    },
    { "say": "sdlc pause" },
    {
      "tool": ["WebFetch", { "url": "https://example.com/?q=notes" }],
      "expect": "deny",
      "why": "a URL can carry data out while a person has stopped the agents"
    },
    {
      "tool": ["WebSearch", { "query": "notes" }],
      "expect": "deny"
    },
    {
      "tool": ["Grep", { "pattern": "x" }],
      "expect": "allow"
    }
  ]
}

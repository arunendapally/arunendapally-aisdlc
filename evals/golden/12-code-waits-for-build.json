{
  "name": "code-waits-for-build",
  "promise": "In the full lane no code is written before the plan is approved, and each artefact waits for the gate before it.",
  "steps": [
    { "sdlc": ["init", "demo"], "ok": true },
    { "write": ["src/app.ts", "x"], "expect": "deny" },
    { "write": ["specs/demo/spec.md", "x"], "expect": "deny" },
    { "write": ["docs/notes.md", "x"], "expect": "allow" },
    { "setState": ["demo", { "stage": 4 }] },
    { "write": ["src/app.ts", "x"], "expect": "allow" }
  ]
}

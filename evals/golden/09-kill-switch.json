{
  "name": "kill-switch",
  "promise": "Any human can stop every agent write and command, and only a human can start them again.",
  "steps": [
    { "say": "sdlc pause", "out": "paused all agents" },
    { "bash": "ls", "expect": "deny" },
    { "write": ["src/a.ts", "x"], "expect": "deny" },
    { "bash": "echo sdlc resume", "expect": "deny" },
    { "say": "sdlc resume", "out": "resumed" },
    { "bash": "ls", "expect": "allow" }
  ]
}
